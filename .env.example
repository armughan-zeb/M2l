# Vidzeo Muse worker configuration.
# Copy to .env (or set the variables in your shell). Never commit .env.
#
# The worker stores its own bearer token in .muse-agent.json (gitignored).
# No provider or OpenRouter key belongs in this repository.
#
# MUSE INFERENCE IS COMPULSORY. Every narration, shot-plan, and 2D Stickman
# choreography request goes through Muse (MUSE_INFERENCE_COMMAND /
# MUSE_INFERENCE_URL / agent-bridge inbox) — never OpenRouter.
MUSE_INFERENCE_COMPULSORY=1

# CMS address. Pairing writes the chosen address into .muse-agent.json.
MUSE_CMS_URL=http://127.0.0.1:3210

# Optional worker log verbosity: info | debug
MUSE_LOG_LEVEL=info

# Thumbnails are SKIPPED by default: Muse delivers script + video only;
# Pikgen generates thumbnails locally on the CMS host.
VIDZEO_SKIP_THUMBNAILS=1

# Optional custom paths / overrides:
# MUSE_DOCUMENTARY_ROOT=./one_minute_documentary
# MUSE_STICKMAN_ROOT=./2d-stickman
# MUSE_HATCH_TTS_BIN=/opt/hatch/bin/tts
# REMOTION_BROWSER_EXECUTABLE=/opt/chrome-headless-shell-linux64/chrome-headless-shell
# MUSE_INFERENCE_COMMAND=node ./scripts/muse-inference-spool.cjs
