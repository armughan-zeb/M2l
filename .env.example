# Vidzeo Muse worker configuration.
# Copy to .env (or set the variables in your shell). Never commit .env.
#
# The worker stores its own bearer token in .muse-agent.json (gitignored).
# No provider or OpenRouter key belongs in this repository. Agent-driven jobs
# are written and rendered by the Muse environment itself.

# CMS address. Pairing writes the chosen address into .muse-agent.json.
MUSE_CMS_URL=http://127.0.0.1:3210

# Optional worker log verbosity: info | debug
MUSE_LOG_LEVEL=info

# --- Narration (ScriptIT) ---------------------------------------------------
# Default engine: the ScriptIT headless CLI (scriptit/cli/generate.js). It
# researches the title, writes narration through the editorial gate, and
# needs no OpenRouter key — Muse answers its inference requests through the
# Vidnets agent-bridge inbox (see scriptit/CLI.md). No setting is needed.
# Agent-bridge mode gives each inference request a 45-minute budget because
# the operator answers at human speed; override with:
# MUSE_SCRIPT_TIMEOUT_MS=2700000
#
# A custom writing command still wins when set. It receives the job JSON on
# stdin and prints either the narration text or {"scriptText":"..."}.
# Linux / Ubuntu example:
# MUSE_SCRIPT_COMMAND=node /opt/vidzeo/scripts/muse-script.js
# Windows example:
# MUSE_SCRIPT_COMMAND=node C:\path\to\muse-script.js
# MUSE_SCRIPT_TIMEOUT_MS=600000
# Set to 0 to disable the single bounded expansion for a short first pass.
# MUSE_SCRIPT_EXPAND_ON_SHORT=1
# Opt-in only: bring back the old generic template synthesizer as the
# default instead of ScriptIT (labelled template-synthesizer-generic).
# MUSE_SCRIPT_ALLOW_TEMPLATE_FALLBACK=1
# Optional: OpenRouter mode for the CLI (a key and a free model).
# SCRIPTIT_API_KEY=
# SCRIPTIT_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Video rendering ---------------------------------------------------------
# Preferred: your Muse environment's renderer. It receives JSON on stdin with
# job, scriptText, scriptPath, workDir and outputPath, and prints
# {"videoPath":"...","thumbnailPath":"..."} (thumbnailPath is optional).
# Linux / Ubuntu example:
# MUSE_RENDER_COMMAND=node /opt/vidzeo/scripts/muse-render.js
# Windows example:
# MUSE_RENDER_COMMAND=node C:\path\to\muse-render.js

# Built-in Vidnets path. The launcher must be paired locally once (see
# vidnets/AGENT_ACCESS.md). The worker starts it and services its inference
# inbox while a render runs.
# Linux: defaults to ./vidnets/VIDNETS_AGENT.sh
# Windows: defaults to .\vidnets\VIDNETS_AGENT.cmd
# MUSE_VIDNETS_COMMAND=./vidnets/VIDNETS_AGENT.sh
# MUSE_VIDNETS_ROOT=/opt/vidzeo/vidnets

# Required only when Vidnets asks for reasoning/vision. The command receives
# one request JSON on stdin and must print the exact requested answer.
# MUSE_INFERENCE_COMMAND=node /opt/vidzeo/scripts/muse-inference.js
# HTTP alternative; accepts {"content":"..."} or plain text.
# MUSE_INFERENCE_URL=http://127.0.0.1:7777/answer
# MUSE_INFERENCE_TIMEOUT_MS=600000

# Built-in Vidnets stock rescue providers.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# MUSE_RENDER_CONCURRENCY=4
# MUSE_YOUTUBE_COVERAGE_TARGET=0.6

# --- Thumbnail ---------------------------------------------------------------
# Optional custom thumbnail command. Receives JSON on stdin with job,
# scriptText, videoPath and workDir; prints {"thumbnailPath":"..."}.
# MUSE_THUMBNAIL_COMMAND=node /opt/vidzeo/scripts/muse-thumbnail.js
# Frame extraction fallback position in seconds; otherwise a safe early frame.
# MUSE_THUMBNAIL_AT_SECONDS=

# --- Media & Python tools ----------------------------------------------------
# FFprobe/FFmpeg are required for local master and thumbnail checks.
# On Linux/Ubuntu: usually discovered automatically at /usr/bin/ffmpeg or via PATH.
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg
# MUSE_FFMPEG_DIR=/usr/bin
# Python 3 path (Linux/Ubuntu: python3, Windows: python)
# VIDNETS_PYTHON=python3

# --- Bounds ------------------------------------------------------------------
# MUSE_RENDER_TIMEOUT_MS=21600000
# MUSE_UPLOAD_TIMEOUT_MS=1800000
# MUSE_POLL_MS=3000
# MUSE_HEARTBEAT_MS=20000
# MUSE_PROGRESS_KEEPALIVE_MS=90000
