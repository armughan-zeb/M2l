# =============================================================================
# VIDNETS STUDIO - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git - it's in .gitignore by default.

# =============================================================================
# API Keys
# =============================================================================

# =============================================================================
# Optional API Keys
# =============================================================================

# OpenRouter API Key (all brain, query, editorial, and scene-planning work)
# Get a key at: https://openrouter.ai/keys
# Also read from: VIDZEO_OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Optional official Brave Image Search API (avoids HTML scraping challenges).
# Get a key at https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# Optional free SearXNG instances (comma-separated). Enable with the built-in
# rotating pool or set your own instances for best reliability and control.
# VIDZEO_SEARXNG_ENABLE=1
# VIDZEO_SEARXNG_URLS=https://your-searx.example,https://another-searx.example

# Together AI API Key (image generation)
# Also read from: VIDZEO_TOGETHER_API_KEY
TOGETHER_API_KEY=

# OpenAI API Key (fallback LLM provider)
# Also read from: VIDZEO_OPENAI_API_KEY
OPENAI_API_KEY=

# Pollinations API Key (optional - enhances image generation speed)
# Get a key at: https://pollinations.ai/
# Also read from: POLLINATIONS_TOKEN, VIDZEO_POLLINATIONS_API_KEY
POLLINATIONS_API_KEY=

# Pexels API Key (optional - stock image/video fallback)
# Get a key at: https://www.pexels.com/api/
# Also read from: VIDZEO_PEXELS_API_KEY
PEXELS_API_KEY=

# Pixabay API Key (optional - stock image/video fallback)
# Get a key at: https://pixabay.com/api/docs/
# Also read from: VIDZEO_PIXABAY_API_KEY
PIXABAY_API_KEY=

# =============================================================================
# LLM Provider Selection
# =============================================================================

# The only LLM provider is OpenRouter.
VIDZEO_LLM_PROVIDER=openrouter
VIDZEO_LLM_MODEL=qwen/qwen3.5-flash-02-23
# Also read from: LLM_PROVIDER
# LLM model override (default: qwen/qwen3.5-flash-02-23)
# Also read from: LLM_MODEL

# Reuse schema-validated text responses within a project and concurrent work.
# New videos still receive independent direction. Set 0 for fresh text responses.
VIDZEO_RESPONSE_CACHE=1

# Visual verification for web images and YouTube frames. This uses the same
# OpenRouter key as the text-planning model.
VIDZEO_YANDEX_IMAGES=1
# Browser fallback is challenge-only and uses a local Playwright Chromium
# session without cookies; it is bounded so other providers remain fast.
VIDZEO_YANDEX_BROWSER_FALLBACK=1
VIDZEO_QWEN_VISION_MODEL=qwen/qwen3.5-flash-02-23
VIDZEO_QWEN_VISION_FALLBACK_MODEL=qwen/qwen3.5-flash-02-23
VIDZEO_QWEN_VISION_FALLBACK_MODELS=qwen/qwen3.5-flash-02-23
# Compact semantic probes; original media stays full quality for rendering.
VIDZEO_VISION_IMAGE_PROBE_EDGE=512
VIDZEO_VISION_FRAME_PROBE_EDGE=384
VIDZEO_SCENE_BRAIN_MODEL=qwen/qwen3.5-flash-02-23
VIDZEO_SCENE_BRAIN_FALLBACK_MODELS=qwen/qwen3.5-flash-02-23
VIDZEO_SCENE_BRAIN_FALLBACK_CHAIN=qwen/qwen3.5-flash-02-23
VIDZEO_EDITORIAL_DIRECTOR_MODEL=qwen/qwen3.5-flash-02-23
VIDZEO_EDITORIAL_DIRECTOR_FALLBACK_MODELS=qwen/qwen3.5-flash-02-23
# The editorial director plans in small, context-rich parallel chunks. Each
# remote stage has a bounded deadline; failed chunks keep the rest of the film.
VIDZEO_EDITORIAL_DIRECTOR_MAX_ATTEMPTS=2
VIDZEO_EDITORIAL_DIRECTOR_TOTAL_TIMEOUT_SECONDS=90
# Scale the deadline by parallel waves, including a bounded composition pass.
VIDZEO_EDITORIAL_DIRECTOR_ADAPTIVE_BUDGET=1
VIDZEO_EDITORIAL_DIRECTOR_MAX_TOTAL_TIMEOUT_SECONDS=3600
VIDZEO_EDITORIAL_DIRECTOR_ART_TIMEOUT_SECONDS=20
VIDZEO_EDITORIAL_DIRECTOR_SCENE_TIMEOUT_SECONDS=55
VIDZEO_EDITORIAL_DIRECTOR_COMPOSITION_TIMEOUT_SECONDS=40
VIDZEO_EDITORIAL_COMPOSITION_MODEL=qwen/qwen3.5-flash-02-23
VIDZEO_EDITORIAL_DIRECTOR_REPAIR_TIMEOUT_SECONDS=10
VIDZEO_EDITORIAL_DIRECTOR_SCENE_BATCH_SIZE=2
VIDZEO_EDITORIAL_DIRECTOR_SCENE_WORKERS=4
VIDZEO_EDITORIAL_DIRECTOR_SCENE_MAX_TOKENS=4800
VIDZEO_DIRECTOR_OVERLAY_RATIO=0.50
# Never leave a Mixed/automatic scene blank: use a grounded, auditable
# fallback graphic only after real provider and timestamp rescue attempts.
VIDZEO_GLOBAL_MEDIA_GUARANTEE=1
VIDZEO_MEDIA_FALLBACK_POLICY=grounded_graphic
VIDZEO_ALLOW_GROUNDED_GRAPHIC_FALLBACK=1
VIDZEO_ALLOW_GROUNDED_GRAPHIC_FALLBACK_STRICT=1
VIDZEO_MEDIA_PROVIDER_RETRIES=2

# YouTube editorial diversity. The opening 15 seconds uses distinct masters;
# later bite clips can take several verified moments from one master source.
VIDZEO_YT_BITE_TIMESTAMP_GAP=8
VIDZEO_YT_BITE_REUSE_CAP=4

# =============================================================================
# Path Configuration
# =============================================================================

# Project root directory (auto-detected if empty)
VIDZEO_ROOT=

# Output directory for generated videos (default: ./output)
# Also read from: VIDZEO_OUTPUT_DIR
OUTPUT_DIR=

# Temporary working directory (default: ./temp)
# Also read from: VIDZEO_TEMP_DIR
TEMP_DIR=

# Fonts directory (default: ./fonts)
VIDZEO_FONTS_DIR=

# Frontend src directory (default: ./src)
VIDZEO_SRC_DIR=

# Server bind host (default: 127.0.0.1)
VIDZEO_BIND_HOST=127.0.0.1

# Server port (default: 5000)
PORT=5000

# Enable debug mode (set to 'false' in production)
DEBUG=true

# =============================================================================
# Supabase / Auth
# =============================================================================

# Sign-in with Google requires a Supabase project and Google OAuth client.
# Public keys are safe to ship (anon key has RLS enforced).
# Never ship a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_CLIENT_ID=

# =============================================================================
# Polar Billing (server/Supabase Edge Functions only)
# =============================================================================
# Never put these in the website, Electron package, or public environment file.
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=835ef172-a0d1-4aad-afef-dafdc24028a4
POLAR_API_BASE_URL=https://api.polar.sh
POLAR_WEBHOOK_SECRET=

# =============================================================================
# Video Encoding & Subtitles
# =============================================================================

# Force burn subtitles into video (default: 0=auto, 1=always burn)
# Burning re-encodes video; soft subtitles (mov_text) are used for long videos
VIDZEO_FORCE_BURN_SUBTITLES=0

# Max duration in seconds for burned subtitles (default: 600 = 10 min)
# Videos longer than this use soft subtitles (no re-encode)
VIDZEO_BURN_SUBTITLES_MAX_SECONDS=600

# =============================================================================
# Whisper Transcription
# =============================================================================

# Compute type for faster-whisper: int8, float16, float32 (default: int8)
# Use float16 or float32 for better accuracy (slower, more RAM)
VIDZEO_FASTER_WHISPER_COMPUTE_TYPE=int8

# =============================================================================
# YouTube Clip Pipeline
# Quality-first adaptive source selection (rejects 360p when a better source is available)
VIDZEO_YT_SOURCE_MAX_HEIGHT=1080
VIDZEO_YT_MIN_SOURCE_HEIGHT=720
VIDZEO_YT_OUTPUT_FPS=30
# =============================================================================

# YouTube search concurrency (default: 20)
VIDZEO_YT_SEARCH_CONCURRENCY=20

# YouTube download concurrency (default: 24)
VIDZEO_YT_DOWNLOAD_CONCURRENCY=6

# YouTube selection concurrency (default: 16)
VIDZEO_YT_SELECTION_CONCURRENCY=16

# Timeout in seconds for waiting on an existing download (default: 600)
VIDZEO_YT_EXISTING_DOWNLOAD_TIMEOUT=600

# Max times a single YouTube source can be reused (default: 5)
VIDZEO_YT_MAX_REUSE=5

# Max timestamps per YouTube video (default: 5)
VIDZEO_YT_MAX_TIMESTAMPS=5
VIDZEO_YT_OVERLAY_SCREEN=1
VIDZEO_YT_REJECT_TALKING_HEAD=1
VIDZEO_YT_FACECAM_HARD_CONFIDENCE=0.72
VIDZEO_YT_REJECT_METADATA_TALKING_HEAD=0
VIDZEO_YT_RELEVANCE_ONLY=1
VIDZEO_YT_ACTIVE_DOWNLOAD_GRACE_SECONDS=18
VIDZEO_YT_EXECUTOR_GRACE_SECONDS=25
VIDZEO_YT_WATERMARK_FALLBACK_THRESHOLD=0.65

# =============================================================================
# Media Pipeline Tuning
# =============================================================================

# Enable strict perceptual hash deduplication (default: 0)
VIDZEO_STRICT_PHASH_DEDUP=1

# Allow reusing nearest media across different scenes (default: 0)
VIDZEO_ALLOW_NEAREST_MEDIA_REUSE=0

# Allow reusing nearest video across different scenes (default: 0)
VIDZEO_ALLOW_NEAREST_VIDEO_REUSE=0

# Threshold in seconds for long-form reuse (default: 600)
VIDZEO_LONG_FORM_REUSE_SCENE_THRESHOLD=600

# Mixed media: max web candidates per scene (default: 48)
VIDZEO_MIXED_WEB_MAX_CANDIDATES=48

# Mixed media: scene worker threads (default: 12, bounded)
VIDZEO_MIXED_WEB_SCENE_WORKERS=12

# Mixed media: API worker threads (default: 12, bounded)
VIDZEO_MIXED_WEB_API_WORKERS=12

# Metadata-pending semantic query waves before the shared visual gate.
VIDZEO_WEB_SEMANTIC_PENDING_WAVES=1

# Mixed media: max YouTube download candidates (default: 2)
VIDZEO_MIXED_YT_DOWNLOAD_CANDIDATES=6

# Mixed media: maximum download attempts per scene (default: 2)
VIDZEO_MIXED_YT_DOWNLOAD_ATTEMPTS=6

# Mixed media: parallel ranged YouTube downloads (default: 4, max: 6)
VIDZEO_MIXED_YT_DOWNLOAD_CONCURRENCY=4

# Mixed media: enable shadow web search (default: 0)
VIDZEO_MIXED_YT_SHADOW_WEB=0

# Mixed media: shadow web candidates (default: 4)
VIDZEO_MIXED_YT_SHADOW_WEB_CANDIDATES=4

# Mixed media: web retrieval cap per scene (default: 24)
VIDZEO_MIXED_WEB_RETRIEVAL_CAP=24
# Bounded primary web wave (shared pool + scene downloads). Operators can
# increase the cap for high-latency networks without changing branch startup.
VIDZEO_MIXED_WEB_MIN_WALL_SECONDS=75
VIDZEO_MIXED_WEB_MAX_WALL_SECONDS=120
VIDZEO_MIXED_WEB_LONG_FORM_MAX_WALL_SECONDS=240

# Mixed media: nearest fill threshold (default: 0)
VIDZEO_MIXED_WEB_NEAREST_FILL=0

# Mixed media: strict source contract (default: 0)
VIDZEO_STRICT_MIXED_SOURCE_CONTRACT=0

# Mixed media: strict percentages (default: 0)
VIDZEO_STRICT_MIXED_PERCENTAGES=0

# Mixed media: fail on percentage shortfall (default: 0)
VIDZEO_FAIL_ON_MIXED_PERCENTAGE_SHORTFALL=0

# Debug: enable media heartbeat logging (default: 0)
VIDZEO_DEBUG_MEDIA_HEARTBEAT=0

# Debug: media heartbeat interval in seconds (default: 30)
VIDZEO_DEBUG_MEDIA_HEARTBEAT_SECONDS=30

# Render repair: web candidates (default: 6)
VIDZEO_RENDER_REPAIR_WEB_CANDIDATES=6

# Render repair: YouTube candidates (default: 10)
VIDZEO_RENDER_REPAIR_YT_CANDIDATES=10

# Long-form: YouTube download candidates (default: 60)
VIDZEO_LONG_YT_DOWNLOAD_CANDIDATES=60

# Delivery-first visual retrieval: vision is a relevance veto, not a required
# per-scene gate. A provider outage or exhausted budget must not block video.
VIDZEO_VISUAL_REQUIRED=0
VIDZEO_VISUAL_REJECT_ONLY_IRRELEVANT=1
VIDZEO_DELIVERY_FIRST_MEDIA=1

# Hard production delivery SLO. Every optional stage shares this wall clock
# and retrieval yields before the render reserve. 900s (15 min) is the default;
# long-form jobs (75+ scenes with semantic editing) may expand up to 1800s via
# the same knob.
VIDZEO_VIDEO_DELIVERY_BUDGET_SECONDS=1200
VIDZEO_RENDER_RESERVE_SECONDS=600
# 0 lets the long-form workload formula choose the wall; a job-level value can
# still override it deliberately.
VIDZEO_SEMANTIC_RENDER_BUDGET_SECONDS=0
# Remotion is hard-set to four render workers and preflights 4 GiB available RAM.
VIDZEO_SEMANTIC_RENDER_CONCURRENCY=0
VIDZEO_STRAIGHT_RENDER_BUDGET_SECONDS=150
VIDZEO_CAPTION_BURN_BUDGET_SECONDS=75
VIDZEO_RENDER_BACKEND=remotion
VIDZEO_REMOTION_RENDER=1
# Before rendering, collect Python garbage and page out only Vidnets' idle
# Flask working set when system available RAM is below 20% or 2 GiB.
VIDZEO_RENDER_TRIM_WORKING_SET=1
# Give the Remotion Node render process above-normal priority on Windows.
VIDZEO_RENDER_PRIORITY_ENABLED=1
# Remotion defaults to x264's medium preset. veryfast keeps the configured
# quality target while reducing encode time; worker/cache sizes adapt to RAM.
VIDZEO_REMOTION_X264_PRESET=veryfast
VIDZEO_REMOTION_FAST_X264_PRESET=ultrafast
VIDZEO_REMOTION_CRF=18
VIDZEO_REMOTION_VIDEO_CACHE_MB=256
VIDZEO_RENDER_CONTINUE_WHILE_ACTIVE=1
VIDZEO_REMOTION_MAX_WORKERS=8
VIDZEO_REMOTION_CHUNK_SECONDS=30
# Require narrated grounding for factual charts, maps, dates, and counters.
VIDZEO_SEMANTIC_GRAPHIC_COVERAGE=1.0
VIDZEO_RESTRAINED_TEMPLATES=1
VIDZEO_YT_RETRIEVAL_PRESERVE_SOURCE=1
VIDZEO_FAST_RENDER_CRF=21
VIDZEO_OPENROUTER_TIMEOUT_SECONDS=360
VIDZEO_OPENROUTER_TOTAL_TIMEOUT_SECONDS=1500
VIDZEO_OPENROUTER_MAX_ATTEMPTS=4
VIDZEO_NICHE_ANALYSIS_TIMEOUT_SECONDS=120
VIDZEO_NICHE_ANALYSIS_TOTAL_TIMEOUT_SECONDS=240
VIDZEO_EDITING_PROFILE_TIMEOUT_SECONDS=180
VIDZEO_EDITING_PROFILE_TOTAL_TIMEOUT_SECONDS=360
VIDZEO_EDITORIAL_BRAIN_TOTAL_TIMEOUT_SECONDS=600
VIDZEO_BRANCH_LLM_QUERY_WAIT_SECONDS=360

# Start mixed-media retrieval from script-derived scenes immediately; the
# final Whisper scene map is remapped before render instead of blocking media.
VIDZEO_MIXED_WAIT_FOR_FINAL_AUDIO_SCENES=0
VIDZEO_MIXED_MIN_WEB_RATIO=0.80
VIDZEO_MIXED_YT_TARGET_RATIO=0.55
VIDZEO_MIXED_YT_CLIP_MAX_SECONDS=8
VIDZEO_MIXED_WEB_MISS_USE_YT_POOL=0
# Parallel mixed-media branch startup (web/YouTube/stock). Opt into web-first
# ordering only for jobs that require it.
VIDZEO_MIXED_WEB_FIRST_QUOTA=0
VIDZEO_MIXED_QUERY_PLAN_BACKGROUND_SECONDS=240
VIDZEO_STRICT_MIXED_WEB_MINIMUM=1

# OpenRouter scene planning runs before media retrieval. If it exhausts its
# ordered retries or deadline, the app labels the mechanical safety plan.
VIDZEO_QUERY_PLAN_STAGE_DEADLINE_SECONDS=1500
VIDZEO_QUERY_LLM_CALL_TIMEOUT=120
VIDZEO_QUERY_LLM_MAX_ATTEMPTS=2
VIDZEO_QUERY_LLM_CANDIDATE_RACE_SECONDS=300
VIDZEO_BRAIN_CONTAINER_STAGE_SECONDS=1500
VIDZEO_BRAIN_CONTAINER_REQUEST_BUDGET_SECONDS=1500
VIDZEO_BRAIN_CONTAINER_TIMEOUT=360
VIDZEO_BRAIN_CONTAINER_MAX_ATTEMPTS=3
VIDZEO_BRAIN_CONTAINER_CHUNK_SIZE=18
VIDZEO_BRAIN_CONTAINER_WORKERS=4
VIDZEO_BRAIN_SCENE_BUDGET_SECONDS=1500
VIDZEO_BRAIN_SCENE_TIMEOUT=360
VIDZEO_BRAIN_SCENE_MAX_ATTEMPTS=3
VIDZEO_BRAIN_SCENE_WORKERS=4

# One hard budget is shared by web, YouTube, and the final gate. Long
# delivery-first jobs reuse branch verdicts and never start a per-scene final
# pass. "always" may force the final pass for non-strict debugging; strict
# visual_required jobs still run within this same shared budget.
VIDZEO_VISUAL_SHARED_MAX_CALLS=6
# Optional hard override. Legacy jobs default to 75s; V2 jobs scale with scene count up to 600s.
# VIDZEO_VISUAL_SHARED_DEADLINE_SECONDS=75
VIDZEO_VISUAL_CALL_TIMEOUT_SECONDS=120
VIDZEO_VISUAL_CALL_MAX_ATTEMPTS=3
VIDZEO_QWEN_VISION_TIMEOUT_SECONDS=120
VIDZEO_QWEN_VISION_MAX_ATTEMPTS=3
VIDZEO_VIP_FINAL_GATE_MODE=auto
VIDZEO_VIP_FINAL_LONG_SCENE_THRESHOLD=16

# Keep several YouTube alternatives, but download only one at a time.
VIDZEO_YT_PROGRESSIVE_ATTEMPTS=4

# Paid web vision is a small relevance-veto sample, never a per-scene fan-out.
VIDZEO_WEB_VISION_BUDGET_MIN_SCENES=16
VIDZEO_WEB_VISION_MAX_CALLS=6
VIDZEO_WEB_VISUAL_RETRIES=1
VIDZEO_WEB_STAGE_DEADLINE_SECONDS=120
VIDZEO_WEB_ENABLE_GDL=0
VIDZEO_WEB_SCENE_DOWNLOAD_CONCURRENCY=4
# Reuse only already verified, distinct web assets as a bounded web-only rescue.
VIDZEO_WEB_ALLOW_DETERMINISTIC_REUSE=1
VIDZEO_WEB_MAX_REUSE_PER_ASSET=1

# Single-topic web jobs share one bounded provider batch. Completed provider
# rows are retained immediately even if another provider is slow.
VIDZEO_WEB_BATCH_DISCOVERY_SECONDS=12
VIDZEO_WEB_QUERY_DEADLINE_SECONDS=10
VIDZEO_WEB_FAST_CANDIDATES_PER_QUERY=3
VIDZEO_WEB_FAST_DOWNLOADS_PER_SCENE=6

# Stock rescue uses one bounded batch by default. Early duplicate downloads
# are opt-in because they can hold the same URL twice on slow connections.
VIDZEO_STOCK_EARLY_DOWNLOAD=0
VIDZEO_STOCK_DOWNLOAD_TIMEOUT_SECONDS=75
VIDZEO_STOCK_DOWNLOAD_RETRIES=1
VIDZEO_STOCK_BATCH_TIMEOUT_SECONDS=120

# Electron selects a free port automatically when this preferred port is busy.
# Set only when integrating with a managed local service.
VIDZEO_PORT=5000

# Long pooled YouTube jobs visually sample only a small veto set; transcript
# and strong metadata matches bypass vision, while true irrelevance is rejected.
VIDZEO_YT_POOL_VISION_VETO_BUDGET=6
VIDZEO_YT_POOL_SOURCE_DOWNLOAD_DEADLINE_SECONDS=270
VIDZEO_YT_POOL_SOURCE_RECOVERY_DEADLINE_SECONDS=45
VIDZEO_YT_POOL_DIRECT_CLIP_BYPASS_SCENES=24
VIDZEO_YT_TRANSCRIPT_DEADLINE_SECONDS=25
VIDZEO_MIXED_YT_BRANCH_WALL_TIMEOUT_SECONDS=480
VIDZEO_YT_V2_OUTER_WALL_MAX_SECONDS=420

# YouTube search throttle safeguards: YouTube throttles by IP (not account),
# so even a verified cookie session crawls when searches burst. These knobs
# keep the fan-out bounded and let repeat queries skip the network entirely.
# Search results are cached per query for this many seconds (0 disables).
VIDZEO_YT_SEARCH_CACHE_TTL_SECONDS=21600
# Total queries for one pool job (0 = auto: scenes*3+6, 12..60). Container
# queries are dropped evenly so the strongest query per pool always survives.
VIDZEO_YT_V2_QUERY_TOTAL_CAP=0
# Pacing between search submissions (seconds, 0-3) to avoid request bursts.
VIDZEO_YT_SEARCH_PACE_SECONDS=0.4
# Absolute ceiling for the whole search phase regardless of job config.
VIDZEO_YT_V2_SEARCH_TIMEOUT_CEILING_SECONDS=300

# The shared LLM scene-plan stage (container map + queries) is stochastic per
# model call, so identical reruns can plan different containers and query
# different videos. Caching the plan per script/title/scene-texts makes reruns
# deterministic: identical queries -> full search-cache reuse. TTL in seconds
# (0 disables; FORCE_REFRESH=1 ignores the cached plan for one run).
VIDZEO_YT_PLAN_CACHE_TTL_SECONDS=86400
VIDZEO_YT_PLAN_CACHE_FORCE_REFRESH=0
# Caption handling for downloaded cuts: "reject" (default) hard-rejects any
# cut with burned-in subtitles/score bugs; "blur" blurs the caption band and
# ships the cut (useful for broadcast/fan footage like sports matches).
# Blur only bounded, bottom-anchored source captions; central cards and
# talking-head/facecam layouts remain hard rejected by the verifier.
VIDZEO_YT_CAPTION_POLICY=preserve
VIDZEO_YT_MIN_SOURCE_DURATION=12
VIDZEO_QUERY_PLAN_WAVE_SECONDS=120

# If the web share misses but the job already has validated YouTube clips,
# rotate that clip pool into the remaining slots instead of starting a second
# full web-search loop.
VIDZEO_MIXED_WEB_MISS_USE_YT_POOL=0

# =============================================================================
# Security Note
# =============================================================================
# Runtime diagnostics
VIDZEO_PERSIST_LOGS=1
VIDZEO_HTTP_LOG=1
# Development only: show the child Python console. Packaged builds keep it
# hidden and retain the same output in the UI and logs/backend-activity.log.
VIDZEO_SHOW_BACKEND_CONSOLE=0

# This file contains sensitive API keys. Make sure:
# 1. .env is in your .gitignore
# 2. Never share this file publicly
# 3. Use different keys for development and production
# 4. Rotate keys immediately if they were pasted into chat, logs, or a zip
# 5. Never distribute SUPABASE_SERVICE_ROLE_KEY to end-user machines
VIDZEO_YT_ALLOW_SD_ARCHIVE=1
VIDZEO_YT_ARCHIVE_MIN_SOURCE_HEIGHT=360
