[Unit]
Description=Muse Vidzeo worker daemon (CMS agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/M2l
ExecStart=/home/hatch/workspace/M2l/start-daemon.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/hatch/workspace/M2l/daemon.log
StandardError=append:/home/hatch/workspace/M2l/daemon.log
Environment=HTTP_PROXY=http://hatch-egress-proxy:3128
Environment=HTTPS_PROXY=http://hatch-egress-proxy:3128
Environment=ALL_PROXY=http://hatch-egress-proxy:3128
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
Environment=http_proxy=http://hatch-egress-proxy:3128
Environment=https_proxy=http://hatch-egress-proxy:3128
Environment=all_proxy=http://hatch-egress-proxy:3128
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
Environment=SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem
Environment=REQUESTS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
Environment=CURL_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
Environment=AWS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
Environment=NODE_EXTRA_CA_CERTS=/run/hatch/egress-tls/ca-bundle.pem
Environment=NODE_USE_ENV_PROXY=1
Environment=GIT_SSL_CAINFO=/run/hatch/egress-tls/ca-bundle.pem
Environment=MUSE_INFERENCE_SPOOL_DIR=/home/hatch/workspace/vidnets-runtime/temp/inference-spool

[Install]
WantedBy=multi-user.target
