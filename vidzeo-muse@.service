[Unit]
Description=Vidzeo Muse Production Worker Daemon (instance %i)
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/vidzeo/muse-tools
ExecStart=/usr/bin/node /opt/vidzeo/muse-tools/muse-agent.js start
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
Environment=NODE_ENV=production
Environment=MUSE_LOG_LEVEL=info
Environment=MUSE_AUTO_LOOP=1

[Install]
WantedBy=multi-user.target
